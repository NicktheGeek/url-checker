# Fill these in as you get them. Leave any line blank (or delete it) and that
# source will just be skipped -- the app fails gracefully, not with an error.
# Never commit this file to git (.gitignore already excludes it).

# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# https://www.virustotal.com -- API key is on your profile page
VIRUSTOTAL_API_KEY=

# https://urlscan.io/user/signup -- key is in account settings
URLSCAN_API_KEY=

# https://www.ipqualityscore.com/create-account
IPQS_API_KEY=

# abuse.ch now requires a free Auth-Key for every API request (URLhaus and
# ThreatFox both use the same key). Get one at https://auth.abuse.ch/ --
# without it these two sources are skipped.
URLHAUS_AUTH_KEY=
THREATFOX_AUTH_KEY=

# https://www.phishtank.com/developer_info.php
PHISHTANK_API_KEY=

# https://www.abuseipdb.com/register -- reputation for the resolved IP, not
# the domain
ABUSEIPDB_API_KEY=

# https://otx.alienvault.com/api -- sign in, key is under your profile
OTX_API_KEY=

# https://metadefender.opswat.com/ -- free tier available under "API Key" in
# account settings
METADEFENDER_API_KEY=

# https://www.criminalip.io/ -- free tier available, key is under mypage.
# Free tier has a small daily domain-scan quota shared across all lookups.
CRIMINALIP_API_KEY=

# https://dash.cloudflare.com/ -- Radar URL Scanner needs BOTH an API token
# and your account ID (right sidebar of any domain's Overview page). The
# token MUST be a Custom Token (My Profile > API Tokens > Create Token) with
# permission "Account > URL Scanner" set to "Edit" -- a token without that
# exact permission group authenticates fine for other endpoints but gets a
# 403 "Authentication error" specifically from the URL Scanner API.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Spamhaus DBL needs no key -- it's a free DNS-based lookup and runs
# automatically, same as the local heuristics.
