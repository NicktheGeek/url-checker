# Fill these in as you get them. Leave any line blank (or delete it) and that
# source will just be skipped -- the app fails gracefully, not with an error.
# Never commit this file to git (.gitignore already excludes it).

# https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# https://www.virustotal.com -- API key is on your profile page
VIRUSTOTAL_API_KEY=

# https://urlscan.io/user/signup -- key is in account settings
URLSCAN_API_KEY=

# https://www.ipqualityscore.com/create-account
IPQS_API_KEY=

# abuse.ch now requires a free Auth-Key for every API request (URLhaus and
# ThreatFox both use the same key). Get one at https://auth.abuse.ch/ --
# without it these two sources are skipped.
URLHAUS_AUTH_KEY=
THREATFOX_AUTH_KEY=

# https://www.phishtank.com/developer_info.php
PHISHTANK_API_KEY=
